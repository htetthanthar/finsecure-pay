# Non-sensitive runtime configuration (rendered into a hashed ConfigMap).
# Secrets (API_KEYS) are NOT here - they come from the finsecure-pay-secrets Secret.
APP_ENV=production
LOG_LEVEL=INFO
MAX_TRANSACTION_AMOUNT=10,000
REVIEW_THRESHOLD=5000
ALLOWED_CURRENCIES=SGD,USD,EUR,GBP,MYR,JPY
BLOCKED_COUNTRIES=KP,IR
DUPLICATE_WINDOW_SECONDS=300
ENABLE_API_DOCS=true
# Fraction (0-1) of /validate requests that fail with HTTP 500. Demo only.
CHAOS_ERROR_RATE=0
# The ALB sits in front of the pods; NetworkPolicy limits who can reach them.
FORWARDED_ALLOW_IPS=*
