# Copy to jenkins/.env and fill in. jenkins/.env is git-ignored - never commit it.

JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8081/

# GitHub repository the pipeline builds
GIT_REPO_URL=https://github.com/htetthanthar/finsecure-pay.git

# Docker Hub: create an access token at hub.docker.com > Account settings > Personal access tokens
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# IAM user finsecure-jenkins-deployer (see README "AWS setup")
AWS_DEPLOYER_ACCESS_KEY_ID=
AWS_DEPLOYER_SECRET_ACCESS_KEY=

# Comma-separated API keys clients must send in the X-API-Key header
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
FINSECURE_API_KEYS=

# SonarCloud: sonarcloud.io > My Account > Security > Generate token
# Also set the project's Administration > Analysis Method to CI-based (Automatic Analysis off).
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=
SONAR_TOKEN=

# E-mail notifications (Gmail: Google Account > Security > App passwords)
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Optional: enables LLM-powered failure analysis (otherwise rule-based only)
ANTHROPIC_API_KEY=

# Linux hosts only: group id of the docker group
DOCKER_GID=0
